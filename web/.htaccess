# ==============================================================================
# INVESTIGA24 — Configuración de Servidor Apache / LiteSpeed (Hostinger)
# ==============================================================================

DirectoryIndex index.html index.php
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Rutas amigables (ej: /servicios -> /servicios.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L,QSA]

  # 3. Fallbacks directos para páginas clave
  RewriteRule ^entrega/?$ entrega.html [L,QSA]
  RewriteRule ^servicios/?$ servicios.html [L,QSA]
  RewriteRule ^como-trabajamos/?$ como-trabajamos.html [L,QSA]
  RewriteRule ^sobre-nosotros/?$ sobre-nosotros.html [L,QSA]
  RewriteRule ^investigaciones/?$ investigaciones.html [L,QSA]
  RewriteRule ^consulta/?$ consulta.html [L,QSA]
</IfModule>

# 3. Seguridad y Cabeceras HTTP
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Caché de Navegador para Rendimiento Rápido
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 5. Proteger archivos sensibles
<FilesMatch "(\.env|\.git|\.md|config\.php)$">
  Order allow,deny
  Deny from all
</FilesMatch>
