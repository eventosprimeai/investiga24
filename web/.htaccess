# ==============================================================================
# INVESTIGA24 — Configuración de Servidor Apache / Hostinger
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Rutas amigables sin extensión .html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [NC,L]

  # 3. Redirección de /entrega directa
  RewriteRule ^entrega/?$ entrega.html [NC,L]
  RewriteRule ^investigaciones/?$ investigaciones.html [NC,L]
  RewriteRule ^servicios/?$ servicios.html [NC,L]
  RewriteRule ^como-trabajamos/?$ como-trabajamos.html [NC,L]
  RewriteRule ^sobre-nosotros/?$ sobre-nosotros.html [NC,L]
  RewriteRule ^consulta/?$ consulta.html [NC,L]
  RewriteRule ^buyer-persona-informe/?$ buyer-persona-informe.html [NC,L]
</IfModule>

# 3. Seguridad y Cabeceras HTTP
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Caché de Navegador para Rendimiento Rápido
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 5. Proteger archivos sensibles
<FilesMatch "(\.env|\.git|\.md|config\.php)$">
  Order allow,deny
  Deny from all
</FilesMatch>
